# Gmail OAuth2 Configuration
# Create these credentials at https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Ollama Configuration (for natural language queries)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# AI Provider Configuration (for smart email filter)
# Supported providers: anthropic, openai
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5-20250929
AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://api.openai.com/v1  # Optional: for OpenAI-compatible APIs
# AI_MAX_CONTEXT_TOKENS=32000            # Optional: default 32000

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
