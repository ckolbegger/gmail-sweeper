{
  "name": "gmail-sweep",
  "version": "0.1.0",
  "description": "Smart Gmail inbox organizer with natural language queries",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "gmail-sweep": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "compile": "pkg dist/cli/index.js --output gmail-sweep"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.2.0",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "googleapis": "^144.0.0",
    "ink": "^4.4.1",
    "ollama": "^0.5.2",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "ink-testing-library": "^4.0.0",
    "pkg": "^5.8.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "gmail",
    "cli",
    "tui",
    "email",
    "organizer"
  ],
  "license": "MIT"
}
