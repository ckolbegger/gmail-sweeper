{
  "name": "gmail-sweep",
  "version": "0.1.0",
  "description": "Smart Inbox Organizer - Gmail organization tool with natural language search",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "gmail-sweep": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup src/cli/index.ts src/web/server.ts --format esm",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "web": "tsx src/web/server.ts",
    "web:build": "vite build src/web/client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "commander": "^12.0.0",
    "dotenv": "^17.2.4",
    "express": "^4.18.0",
    "googleapis": "^130.0.0",
    "ink": "^4.0.0",
    "p-retry": "^6.0.0",
    "react": "^18.0.0",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "ink-testing-library": "^3.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
